# Copy to .env and edit:  cp .env.example .env
# Placeholders only. NEVER commit the real .env file.

# --- Django ---
DJANGO_DEBUG=1
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Public base URL used inside notification links (simulation shows these in the UI)
LESEDI_PUBLIC_BASE_URL=http://localhost:8000
# Change the admin path in production
DJANGO_ADMIN_URL=admin/

# --- Database (PostgreSQL) ---
DATABASE_ENGINE=sqlite
POSTGRES_DB=lesedi
POSTGRES_USER=lesedi
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=

# --- Notifications ---
# "simulation" is the ONLY mode implemented. Nothing is ever sent to real people.
LESEDI_NOTIFICATION_MODE=simulation

# --- Evidence Vault ---
# Fernet key(s), comma-separated; the first key encrypts, all keys can decrypt (rotation).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty AND DJANGO_DEBUG=1, a development-only key is derived from DJANGO_SECRET_KEY.
EVIDENCE_ENCRYPTION_KEYS=
EVIDENCE_STORAGE_DIR=private_storage
EVIDENCE_MAX_BYTES=10485760

# --- Quick Exit target (a neutral, ordinary site) ---
LESEDI_QUICK_EXIT_URL=https://www.wikipedia.org

# --- Email (password reset). Dev default prints emails to the web container log. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@lesedi.invalid

# --- Production only (DJANGO_DEBUG=0) ---
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_BEHIND_TLS_PROXY=0

# --- Community feed (rejected/resolved reports are deleted after this many days) ---
COMMUNITY_RETENTION_DAYS=90

# Optional AI (keep this private; never paste into JS or GitHub)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
